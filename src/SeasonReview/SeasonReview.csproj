<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SeasonReview</AssemblyName>
    <RootNamespace>SeasonReview</RootNamespace>
    <Version>0.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Release builds must not embed local paths (e.g. the PDB path with the user's home
         folder): no debug symbols, and source paths mapped to a neutral root. -->
    <DebugType>none</DebugType>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))=/src/</PathMap>
    <!-- FM27 install folder. Override with: dotnet build -p:GameDir="C:\...\Football Manager 27" -->
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Football Manager 27</GameDir>
    <BepInExDir>$(GameDir)/BepInEx</BepInExDir>
    <!-- Set to false to build without copying into the game: -p:DeployToGame=false -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <!-- The game-independent code is compiled into this DLL, so players install one file. -->
  <ItemGroup>
    <Compile Include="../SeasonReview.Core/**/*.cs" Exclude="../SeasonReview.Core/bin/**;../SeasonReview.Core/obj/**" />
    <EmbeddedResource Include="../../lang/*.txt" LogicalName="SeasonReview.lang.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Local build references only. These files belong to BepInEx / Sports Interactive / Unity
       and are never copied into the repository or the release. -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)/core/Il2CppInterop.Common.dll" Private="false" />

    <Reference Include="$(BepInExDir)/interop/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/UnityEngine.CoreModule.dll" Private="false" />
    <!-- In-game panel (UI Toolkit; the text modules only for font and alignment types). -->
    <Reference Include="$(BepInExDir)/interop/UnityEngine.UIElementsModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/UnityEngine.TextCoreTextEngineModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/SI.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/SI.Bindable.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/SI.Bindable.Reference.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/SI.Interop.dll" Private="false" />
    <Reference Include="$(BepInExDir)/interop/FM.UI.dll" Private="false" />
  </ItemGroup>

  <!-- Installs as BepInEx/plugins/SeasonReview/SeasonReview.dll (+ lang/ for translations). -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <ItemGroup>
      <LangFiles Include="../../lang/*.txt" />
    </ItemGroup>
    <!-- Delete first, then copy as a new file: a running game keeps its own (old) copy intact
         instead of having the loaded file overwritten underneath it. -->
    <Delete Files="$(BepInExDir)/plugins/SeasonReview.dll;$(BepInExDir)/plugins/SeasonReview/SeasonReview.dll" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)/plugins/SeasonReview" />
    <Copy SourceFiles="@(LangFiles)" DestinationFolder="$(BepInExDir)/plugins/SeasonReview/lang" />
    <Message Importance="high" Text="SeasonReview.dll copied to $(BepInExDir)/plugins/SeasonReview" />
  </Target>

</Project>
